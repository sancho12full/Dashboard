[Unit]
Description=Valheim dedicated server (via Box64 on ARM64)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valheim
Group=valheim
WorkingDirectory=/home/valheim
ExecStart=/home/valheim/start_valheim.sh
Restart=on-failure
RestartSec=10
# El server corta a SIGINT cerrando el mundo limpiamente
KillSignal=SIGINT
TimeoutStopSec=60
# Seguridad razonable
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
# Logs a journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
